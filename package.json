{
  "name": "yuguang",
  "version": "0.2.0",
  "private": true,
  "description": "余光 · 使用余光关注比赛，一边用 AI 编程，一边观看比赛。",
  "author": "Aric000",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs && vitest run",
    "check-api": "node scripts/check-api.cjs",
    "desktop-check": "npm run build && electron . --demo --self-test",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist": "npm run build && electron-builder --publish never",
    "assets": "node scripts/make-assets.cjs"
  },
  "dependencies": {
    "json-bigint": "1.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "latest",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.5",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "^4.1.12"
  },
  "build": {
    "appId": "app.yuguang.live",
    "productName": "余光",
    "directories": {
      "output": "release",
      "buildResources": "desktop/assets"
    },
    "files": [
      "web-dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "asar": true,
    "artifactName": "Yuguang-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.sports",
      "icon": "desktop/assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "minimumSystemVersion": "14.0"
    },
    "win": {
      "icon": "desktop/assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Yuguang-${version}-windows-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "Yuguang-${version}-windows-${arch}-portable.${ext}"
    }
  }
}
